# ============================================================
# SkyUp WhatsApp Bot — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── MongoDB ─────────────────────────────────────────────────
# Atlas free tier works. Use an SRV URI for auto-failover.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/skyup?retryWrites=true&w=majority

# ── MSG91 ────────────────────────────────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX

# ── Google Sheets (optional) ─────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=skyup-bot@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_sheet_id
GOOGLE_SHEET_RANGE=Leads!A:J

# ── SkyUp CRM (optional) ─────────────────────────────────────
SKYUP_CRM_LEAD_URL=https://crm.skyupdigital.in/api/leads
SKYUP_CRM_API_KEY=your_crm_api_key

# ── Admin ─────────────────────────────────────────────────────
ADMIN_KEY=change_me_to_a_long_random_string

# ── Support contact ───────────────────────────────────────────
SUPPORT_PHONE=+91 98765 43210
SUPPORT_WA=+91 98765 43210

# ── Portfolio URL ─────────────────────────────────────────────
PORTFOLIO_URL=https://skyupdigital.in

# ── 24/7 Self-ping (Render/Railway free tier) ────────────────
# Pings /health every 10 min to prevent free-tier sleep.
# Leave blank on paid hosts / VPS.
SELF_URL=https://your-app.onrender.com

# ── Session cleanup TTLs ──────────────────────────────────────
SESSION_TTL_DAYS=7
ARCHIVE_TTL_DAYS=30

# ── PDFs ────────────────────────────────────────────────────
# Set these 4 URLs. All others are removed.
# Use Google Drive: https://drive.google.com/uc?export=download&id=FILE_ID
# Or any public HTTPS direct-download URL (S3, CDN etc).

# General SkyUp brochure — sent to EVERY new user on first contact
BROCHURE_PDF=https://your-cdn.com/SkyUp_Company_Brochure.pdf

# 3 portfolio PDFs — sent after a user picks a service in that category
# cat_software → Custom Software & Technology services
PORTFOLIO_PDF_SOFTWARE=https://your-cdn.com/SkyUp_Custom_Software_Portfolio.pdf

# cat_ai + cat_strategy → AI, Automation & Business Strategy services
PORTFOLIO_PDF_AI=https://your-cdn.com/SkyUp_AI_Automation_Portfolio.pdf

# cat_growth + cat_creative → Digital Growth & Creative Design services
PORTFOLIO_PDF_GROWTH=https://your-cdn.com/SkyUp_Digital_Growth_Portfolio.pdf
